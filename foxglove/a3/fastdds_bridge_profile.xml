<?xml version="1.0" encoding="UTF-8"?>
<!-- HDU FastDDS profile: UDPv4 on the currently configured host interfaces.
     Shared memory remains disabled to avoid version mismatches with the
     vendor FastDDS build. Do not pin local IPv4 addresses here: Runner lifecycle
     configuration supplies validated peers and venue addresses can change. -->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>bridge_udp</transport_id>
        <type>UDPv4</type>
        <maxInitialPeersRange>32</maxInitialPeersRange>
      </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="bridge_participant" is_default_profile="true">
      <rtps>
        <useBuiltinTransports>false</useBuiltinTransports>
        <userTransports>
          <transport_id>bridge_udp</transport_id>
        </userTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
