ARG DRIVEOS_PLATFORM=linux/amd64
FROM --platform=${DRIVEOS_PLATFORM} registry.agibot.com/agibot-tech/devops/drive_os:7.0.4 AS driveos_base

FROM driveos_base

ARG THOR_SYSROOT_TARBALL=thirdparty/thor_sysroot/thor-1.0-aarch64-sysroot.tar.gz
ARG http_proxy
ARG https_proxy
ARG all_proxy
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG ALL_PROXY

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV HAS_ROS2=1
ENV IS_THOR=true
ENV TensorRT_ROOT=/usr
ENV CUDA_HOME=/usr/local/cuda
ENV CUDAToolkit_ROOT=/usr/local/cuda
ENV PKG_CONFIG_LIBDIR=/usr/lib/aarch64-linux-gnu/pkgconfig:/usr/share/pkgconfig
ENV LD_LIBRARY_PATH=/usr/lib/aarch64-linux-gnu:/usr/local/cuda/targets/aarch64-linux/lib

# Native x86 build tools from DRIVE OS run the aarch64 cross compiler.  Target
# ROS2/system libraries are restored from a repo-local Thor sysroot bundle, so
# normal package builds do not need the Thor target image or qemu.
COPY ${THOR_SYSROOT_TARBALL} /tmp/thor-aarch64-sysroot.tar.gz
RUN tar -xzf /tmp/thor-aarch64-sysroot.tar.gz -C / \
    && rm -f /tmp/thor-aarch64-sysroot.tar.gz

RUN ln -sfn /usr/local/cuda-12.8 /usr/local/cuda \
    && ln -sfn libprotobuf.so.32 /usr/lib/aarch64-linux-gnu/libprotobuf.so \
    && ln -sfn libacl.so.1 /usr/lib/aarch64-linux-gnu/libacl.so \
    && ln -sfn libz.so.1 /usr/lib/aarch64-linux-gnu/libz.so

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        git \
        cppzmq-dev \
        libacl1-dev \
        libmsgpack-dev \
        libprotobuf-dev \
        libzmq3-dev \
        make \
        patch \
        pkg-config \
        protobuf-compiler \
        python3-catkin-pkg \
        python3-empy \
        python3-lark \
        python3-numpy \
        python3-protobuf \
        python3-yaml \
    && rm -rf /var/lib/apt/lists/*

RUN ldconfig

WORKDIR /work
