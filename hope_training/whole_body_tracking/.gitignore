# Omniverse
**/*.dmp
**/.thumbs

# Python
.DS_Store
**/*.egg-info/
**/__pycache__/
**/.pytest_cache/
**/*.pyc
**/*.pb

# IDE
**/.idea/
**/.vscode/
# Don't ignore the top-level .vscode directory as it is
# used to configure VS Code settings
!.vscode

# Outputs
**/runs/*
**/logs/*
**/recordings/*
**/output/*
**/outputs/*
**/videos/*
**/wandb/*
**/.neptune/*
docker/artifacts/
*.tmp

# Isaac-Sim packman
_isaac_sim*
_repo
_build
.lastformat

*.csv
*.pkl
*.zarr
*.npz

# Ignore asset CONTENTS (meshes/urdf are huge) but keep the package marker files un-excluded —
# `whole_body_tracking.assets.__init__` defines ASSET_DIR and the tracking tasks fail to import
# without it (it silently vanished once as a gitignored file).
**/assets/
!source/whole_body_tracking/whole_body_tracking/assets/
source/whole_body_tracking/whole_body_tracking/assets/*
!source/whole_body_tracking/whole_body_tracking/assets/.gitignore
!source/whole_body_tracking/whole_body_tracking/assets/__init__.py

artifacts/

# Local history may be a directory or a symlink to the pre-replacement backup.
/logs
/outputs
/wandb
/setup_train_env.local.sh

# Keep the selected model_14600 baseline export at the requested stable path.
!checkpoints/
!checkpoints/policy.onnx

# Published PPQ004 / 3star question bank used by HOPEPingPongStationaryRally.
!/assets/
/assets/*
!/assets/stationary_reach_v4_ppq004_generalization_20261022/
/assets/stationary_reach_v4_ppq004_generalization_20261022/*
!/assets/stationary_reach_v4_ppq004_generalization_20261022/*.npz
!/assets/stationary_reach_v4_ppq004_generalization_20261022/*.receipt.json
!/assets/stationary_reach_v4_ppq004_generalization_20261022/README.md
!/assets/stationary_reach_v4_ppq004_generalization_20261022/coverage.json
!/assets/stationary_reach_v4_ppq004_generalization_20261022/generation_report.json
