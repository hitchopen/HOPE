[Unit]
Description=HOPE Host read-only scene
After=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/hope-foxglove/host-bridge.env
ExecStart=/usr/bin/distrobox enter hope -- bash ${HOPE_ROOT}/foxglove/helpers/hope-live-scene
Restart=on-failure
RestartSec=3
KillMode=control-group
TimeoutStopSec=8

[Install]
WantedBy=default.target
