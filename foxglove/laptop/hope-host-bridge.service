[Unit]
Description=HOPE local Foxglove endpoint (Host display and remote control)
After=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/hope-foxglove/host-bridge.env
ExecStart=/usr/bin/distrobox enter hope -- bash ${HOPE_ROOT}/foxglove/helpers/hope-host-bridge
Restart=on-failure
RestartSec=3
KillMode=control-group
TimeoutStopSec=8

[Install]
WantedBy=default.target
