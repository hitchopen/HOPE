ARG ROCKCHIP_BUILDER_PLATFORM=linux/amd64
ARG ROCKCHIP_BUILDER_BASE=debian:bookworm
FROM --platform=${ROCKCHIP_BUILDER_PLATFORM} ${ROCKCHIP_BUILDER_BASE}

ARG ROCKCHIP_SYSROOT_TARBALL=thirdparty/rockchip_sysroot/rockchip-1.0-aarch64-sysroot.tar.gz

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV HAS_ROS2=1
ENV PKG_CONFIG_LIBDIR=/usr/lib/aarch64-linux-gnu/pkgconfig:/usr/share/pkgconfig
ENV LD_LIBRARY_PATH=/usr/lib/aarch64-linux-gnu

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        cmake \
        g++-aarch64-linux-gnu \
        gcc-aarch64-linux-gnu \
        git \
        make \
        pkg-config \
        protobuf-compiler \
        python3-catkin-pkg \
        python3-dev \
        python3-empy \
        python3-lark \
        python3-numpy \
        python3-protobuf \
        python3-yaml \
        libacl1-dev \
        libmsgpack-dev \
        libprotobuf-dev \
        libzmq3-dev \
        cppzmq-dev \
        patch \
    && rm -rf /var/lib/apt/lists/*

# Restore target ROS2/system libraries from a repo-local Rockchip sysroot
# bundle. ADD extracts the tarball directly, so the image does not keep an
# extra compressed copy in a separate layer.
ADD ${ROCKCHIP_SYSROOT_TARBALL} /

RUN ln -sfn libacl.so.1 /usr/lib/aarch64-linux-gnu/libacl.so \
    && ln -sfn libz.so.1 /usr/lib/aarch64-linux-gnu/libz.so

WORKDIR /work
