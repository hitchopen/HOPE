<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hope_bringup</name>
  <version>0.0.0</version>
  <description>Bringup assets for the HOPE ROS 2 stack, including the canonical world frame.</description>
  <maintainer email="maintainer@example.com">HOPE Maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>hope_planner_cpp</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>vrpn_mocap</exec_depend>
  <!-- The OptiTrack backend (optitrack_mct_relay / optitrack_hope_bridge)
       additionally needs the vendored motion_capture_tracking +
       motion_capture_tracking_interfaces packages from this workspace.
       INTENTIONALLY not declared as a dependency: the relay imports the msg
       lazily and fails with an actionable error, so AvatarPro-only
       deployments (deploy with skip-optitrack) stay buildable without them.
       soft-dep: motion_capture_tracking_interfaces (OptiTrack backend only) -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
