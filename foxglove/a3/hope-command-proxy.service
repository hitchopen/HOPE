[Unit]
Description=Compatibility entry for the consolidated HOPE operations service
Requires=hope-lifecycle-supervisor.service
After=hope-lifecycle-supervisor.service
BindsTo=hope-lifecycle-supervisor.service

# No ROS process: old runbooks may start this name without duplicating services.
# New installations enable only hope-lifecycle-supervisor.service.
# Stopping this entry does not stop operations. Manage the canonical service
# explicitly; the command module no longer has an independent process.
[Service]
Type=oneshot
User=agi
ExecStart=/usr/bin/true
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
