  "description": "Match-day A3 health and assert-only E-stop console for HOPE",
  "publisher": "hitchopen",
  "homepage": "https://github.com/hitchopen/HOPE/tree/main/foxglove",
  "version": "0.1.0",
  "license": "Apache-2.0",
