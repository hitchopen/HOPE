#!/usr/bin/env python3
"""Publish the calibrated static ``P1 -> pelvis_link`` TF from JSON."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path
from typing import Sequence

from p1_calibration import load_p1_calibration


def load_calibration(path: Path) -> tuple[str, str, list[float], list[float]]:
    """Share the runtime relay's approval and v3 layout/TF-table checks."""
    calibration = load_p1_calibration(path)
    return (
        calibration.parent_frame, calibration.child_frame,
        list(calibration.translation_m), list(calibration.quaternion_xyzw),
    )


def _parse_arguments(arguments: Sequence[str] | None = None) -> tuple[argparse.Namespace, list[str]]:
    parser = argparse.ArgumentParser(
        description="Publish the static P1 -> pelvis_link TF from an approved v3 sticker receipt."
    )
    parser.add_argument(
        "--calibration-file",
        type=Path,
        required=True,
        help="approved v3 JSON receipt written by p1_marker_cad_calibrator",
    )
    return parser.parse_known_args(arguments)


def main() -> int:
    args, ros_arguments = _parse_arguments()
    try:
        parent, child, translation, quaternion = load_calibration(args.calibration_file)
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        print(f"Cannot load P1 calibration: {exc}", file=sys.stderr)
        return 1

    try:
        import rclpy
        from geometry_msgs.msg import TransformStamped
        from rclpy.node import Node
        from tf2_ros.static_transform_broadcaster import StaticTransformBroadcaster
    except ImportError as exc:
        print(f"ROS 2 dependencies are unavailable: {exc}", file=sys.stderr)
        return 2

    class P1PelvisStaticPublisher(Node):
        def __init__(self) -> None:
            super().__init__("p1_pelvis_tf_publisher")
            self.broadcaster = StaticTransformBroadcaster(self)
            transform = TransformStamped()
            transform.header.stamp = self.get_clock().now().to_msg()
            transform.header.frame_id = parent
            transform.child_frame_id = child
            transform.transform.translation.x = translation[0]
            transform.transform.translation.y = translation[1]
            transform.transform.translation.z = translation[2]
            transform.transform.rotation.x = quaternion[0]
            transform.transform.rotation.y = quaternion[1]
            transform.transform.rotation.z = quaternion[2]
            transform.transform.rotation.w = quaternion[3]
            self.broadcaster.sendTransform(transform)
            self.get_logger().info(
                f"publishing calibrated static TF {parent} -> {child} from {args.calibration_file}"
            )

    rclpy.init(args=ros_arguments)
    node = P1PelvisStaticPublisher()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
