[Unit]
Description=HOPE Runner live P1 marker count for Foxglove
After=network-online.target

[Service]
Type=simple
Environment=ROS_DOMAIN_ID=232
Environment=ROS_LOCALHOST_ONLY=0
Environment=RMW_IMPLEMENTATION=rmw_fastrtps_cpp
Environment=PYTHONPATH=/usr/local/lib/hope-foxglove
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && exec python3 /usr/local/bin/hope_marker_monitor.py --ros-args --params-file /etc/hope-foxglove/marker_monitor.yaml'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
