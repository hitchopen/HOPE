#!/usr/bin/env bash
# HOPE_RUNNER_MODE=model21800
# HOPE_HARDWARE_PROFILE=A3_T3D0_ELINK_HAND_V2
# Fixed, role-specific process helper for the Runner Laptop/HDU/MDU lifecycle.
# The HDU ROS supervisors are the only intended callers. No command, path,
# user, environment-variable name, or arbitrary argument is accepted from
# Foxglove. The two root-only MDU clock actions accept no data arguments.

set -euo pipefail
umask 077
export LC_ALL=C
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

readonly LAPTOP_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/hope-foxglove/lifecycle.env"
if [[ -r "$LAPTOP_CONFIG" ]]; then
  # This file is owned by the operator account and contains only local paths
  # and usernames. Robot-side invocations normally use the defaults below.
  source "$LAPTOP_CONFIG"
fi

readonly SELF="$(readlink -f "${BASH_SOURCE[0]}")"
readonly HOPE_ROOT="${HOPE_ROOT:-$HOME/HOPE}"
readonly LAPTOP_SHARE="${HOPE_LAPTOP_SHARE:-${XDG_DATA_HOME:-$HOME/.local/share}/hope-foxglove}"
readonly LAPTOP_USER="${HOPE_LAPTOP_USER:-$(id -un)}"
readonly ROBOT_USER="${HOPE_ROBOT_USER:-agi}"
readonly HDU_WS="${HOPE_HDU_WS:-$HOME/hope_ws}"
readonly LAPTOP_SESSION=hope-optitrack
readonly HDU_BASE_SESSION=hope-base
readonly HDU_PLANNER_SESSION=hope-planner
readonly HDU_RUNNER_TRANSPORT_SESSION=hope-runner-transport
readonly MDU_ELINK_SESSION=hope-elink
readonly MDU_HAL_SESSION=hope-hal
readonly MDU_RUNNER_SESSION=hope-runner
readonly MDU_DEPLOY="${HOPE_MDU_DEPLOY:-/agibot/a3_deploy_model21800}"
readonly MDU_ROS_PREFIX=/opt/ros/jazzy
readonly MDU_ROS_PYTHON_SITE="${MDU_ROS_PREFIX}/lib/python3.11/site-packages"
readonly MDU_VENDOR_ROS_PREFIX=/opt/agibot/share/ros2_package/aimrt_protocol_ros2_package
readonly MDU_VENDOR_PYTHON_SITE="${MDU_VENDOR_ROS_PREFIX}/lib/python3.11/site-packages"
readonly MDU_ROBOT_MODEL_FILE=/agibot/data/info/model
readonly MDU_SUPPORTED_ROBOT_MODEL=A3_T3D0
readonly MDU_ELINK_CONFIG=/opt/agibot/config/hal_elink/hal_elink_a3_cfg.yaml
readonly MDU_HAL_GRIPPER_BASE_CONFIG=/opt/agibot/config/hal_ethercat/hal_ethercat_a3_t3d0_cfg.yaml

emit() {
  local step="$1" state="$2" reason="$3"
  [[ "$step" =~ ^[A-Z0-9_]+$ ]]
  [[ "$state" =~ ^[A-Z]+$ ]]
  [[ "$reason" =~ ^[A-Z0-9_]+$ ]]
  printf 'HOPE_LIFECYCLE_V1 step=%s state=%s reason=%s\n' \
    "$step" "$state" "$reason"
}

die() {
  emit "$1" FAILED "$2"
  exit 1
}

valid_ipv4() {
  local value="$1" part
  [[ "$value" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 1
  local IFS=.
  read -r -a parts <<< "$value"
  [[ "${#parts[@]}" == 4 ]] || return 1
  for part in "${parts[@]}"; do
    [[ "$part" =~ ^(0|[1-9][0-9]{0,2})$ ]] || return 1
    (( 10#$part <= 255 )) || return 1
  done
  [[ "$value" != 0.0.0.0 && "$value" != 255.255.255.255 ]] || return 1
  if (( 10#${parts[0]} == 10 )); then
    return 0
  fi
  if (( 10#${parts[0]} == 172 && 10#${parts[1]} >= 16 && 10#${parts[1]} <= 31 )); then
    return 0
  fi
  (( 10#${parts[0]} == 192 && 10#${parts[1]} == 168 ))
}

network_static_peers() {
  local env_file=/etc/hope-foxglove/network.env
  local line value="" count=0
  [[ -r "$env_file" ]] || return 1
  while IFS= read -r line || [[ -n "$line" ]]; do
    case "$line" in
      ROS_STATIC_PEERS=*)
        value="${line#ROS_STATIC_PEERS=}"
        ((count += 1))
        ;;
    esac
  done < "$env_file"
  (( count == 1 )) || return 1
  printf '%s\n' "$value"
}

static_peer_list_contains() {
  local peer_list="$1" expected="$2" peer
  local IFS=';'
  read -r -a peers <<< "$peer_list"
  for peer in "${peers[@]}"; do
    [[ "$peer" == "$expected" ]] && return 0
  done
  return 1
}

parse_common() {
  [[ "$#" == 6 || "$#" == 8 ]] || return 1
  SESSION_ID="$1"
  LAPTOP_WIFI_IP="$2"
  HDU_WIFI_IP="$3"
  MDU_INTERNAL_IP="$4"
  MOTIVE_IP="$5"
  TABLE_SIDE="$6"
  FIELD_MODE="${7:-OPTITRACK}"
  SERVE_CSV_SHA="${8:-DEFAULT}"
  [[ "$FIELD_MODE" != PURE_SERVE ]] || FIELD_MODE=KERNEL
  [[ "$FIELD_MODE" == OPTITRACK || "$FIELD_MODE" == KERNEL ]] || return 1
  [[ "$SERVE_CSV_SHA" == DEFAULT || "$SERVE_CSV_SHA" =~ ^[0-9a-f]{64}$ ]] || return 1
  [[ "$SESSION_ID" =~ ^model21800_[0-9]{8}T[0-9]{6}Z$ ]] || return 1
  valid_ipv4 "$LAPTOP_WIFI_IP" || return 1
  valid_ipv4 "$HDU_WIFI_IP" || return 1
  valid_ipv4 "$MDU_INTERNAL_IP" || return 1
  [[ "$MOTIVE_IP" == NONE ]] || valid_ipv4 "$MOTIVE_IP" || return 1
  [[ "$TABLE_SIDE" == P1 || "$TABLE_SIDE" == P2 ]] || return 1
}

require_user() {
  [[ "$(id -un)" == "$1" ]] || die "$2" WRONG_USER
}

tmux_exists() {
  /usr/bin/tmux has-session -t "$1" 2>/dev/null
}

cgroup_path_in_systemd_unit() {
  local cgroup_path="$1" unit="$2"
  local unit_root="/system.slice/$unit"
  [[ "$cgroup_path" == "$unit_root" || "$cgroup_path" == "$unit_root/"* ]]
}

pid_in_systemd_unit() {
  local pid="$1" unit="$2"
  local hierarchy controllers cgroup_path
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  [[ -r "/proc/$pid/cgroup" ]] || return 1
  while IFS=: read -r hierarchy controllers cgroup_path; do
    if cgroup_path_in_systemd_unit "$cgroup_path" "$unit"; then
      return 0
    fi
  done < "/proc/$pid/cgroup"
  return 1
}

has_unmanaged_hal() {
  local pid
  while IFS= read -r pid; do
    [[ -n "$pid" ]] || continue
    if ! pid_in_systemd_unit "$pid" agibot_pm.service; then
      printf 'hope-lifecycle: HAL pid %s is outside agibot_pm.service\n' "$pid" >&2
      return 0
    fi
  done < <(pgrep -f '[a]imrt_main_hal' || true)
  return 1
}

has_unmanaged_elink() {
  local pid
  while IFS= read -r pid; do
    [[ -n "$pid" ]] || continue
    if ! pid_in_systemd_unit "$pid" agibot_pm.service; then
      printf 'hope-lifecycle: hal_elink pid %s is outside agibot_pm.service\n' "$pid" >&2
      return 0
    fi
  done < <(pgrep -f '[a]imrt_main .*hal_elink_a3(_ultra)?_(cfg|gripper)[.]yaml' || true)
  return 1
}

start_tmux() {
  local session="$1"
  shift
  tmux_exists "$session" && return 2
  # Do not let a detached runtime inherit the supervisor SSH capture pipes.
  # Otherwise a successful remote start can keep subprocess.run() waiting for
  # EOF and leave the lifecycle stuck at the previous step.
  /usr/bin/tmux new-session -d -s "$session" -- "$@" \
    </dev/null >/dev/null 2>&1
}

stop_tmux() {
  local session="$1"
  tmux_exists "$session" || return 0
  /usr/bin/tmux send-keys -t "$session:0.0" C-c
  local attempt
  for attempt in {1..50}; do
    tmux_exists "$session" || return 0
    sleep 0.1
  done
  /usr/bin/tmux kill-session -t "$session"
}

wait_for_session_log() {
  local session="$1" log_file="$2" marker="$3" attempts="$4"
  local attempt
  for ((attempt = 0; attempt < attempts; attempt++)); do
    if [[ -r "$log_file" ]] && grep -Fq -- "$marker" "$log_file"; then
      return 0
    fi
    tmux_exists "$session" || return 1
    sleep 0.25
  done
  return 1
}

time_calibration_require_root() {
  [[ "$(id -u)" == 0 ]] || die TIME_CALIBRATION ROOT_REQUIRED
  [[ "$#" == 0 ]] || die TIME_CALIBRATION INVALID_ARGUMENTS
  [[ "${SUDO_USER:-}" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || \
    die TIME_CALIBRATION INVALID_SUDO_USER
}

time_calibration_check_mdu() {
  time_calibration_require_root "$@"
  pgrep -f '[a]3_deploy_onnx_ref_pingpong' >/dev/null && \
    die TIME_CALIBRATION RUNNER_PRESENT
  has_unmanaged_hal && die TIME_CALIBRATION NON_VENDOR_HAL_PRESENT
  has_unmanaged_elink && die TIME_CALIBRATION NON_VENDOR_ELINK_PRESENT
  /usr/bin/systemctl is-active --quiet agibot-mdu-ptp4l.service || \
    die TIME_CALIBRATION MDU_PTP4L_NOT_ACTIVE
  /usr/bin/systemctl is-active --quiet agibot-mdu-phc2sys.service || \
    die TIME_CALIBRATION MDU_PHC2SYS_NOT_ACTIVE
  /usr/bin/systemctl is-active --quiet agibot_pm.service || \
    die TIME_CALIBRATION MDU_AGIBOT_PM_NOT_ACTIVE
  emit TIME_CALIBRATION COMPLETE MDU_PREFLIGHT_READY
}

time_calibration_recover_mdu() {
  time_calibration_require_root "$@"
  pgrep -f '[a]3_deploy_onnx_ref_pingpong' >/dev/null && \
    die TIME_CALIBRATION RUNNER_PRESENT
  has_unmanaged_hal && die TIME_CALIBRATION NON_VENDOR_HAL_PRESENT
  has_unmanaged_elink && die TIME_CALIBRATION NON_VENDOR_ELINK_PRESENT

  if /usr/bin/systemctl is-active --quiet agibot-mdu-ptp4l.service &&
     /usr/bin/systemctl is-active --quiet agibot-mdu-phc2sys.service &&
     /usr/bin/systemctl is-active --quiet agibot_pm.service; then
    emit TIME_CALIBRATION COMPLETE MDU_BASELINE_ALREADY_READY
    return
  fi

  # Recovery is intentionally receipt-bound. Never turn arbitrary stopped
  # robot services back on merely because a calibration request arrived.
  local run_dir=/run/hope-time-calibration
  local active_file="$run_dir/mdu-active-services"
  local state_file="$run_dir/mdu-state"
  local boot_file="$run_dir/mdu-boot-id"
  local current_boot
  current_boot="$(< /proc/sys/kernel/random/boot_id)"
  [[ -r "$active_file" && -r "$state_file" && -r "$boot_file" ]] || \
    die TIME_CALIBRATION MDU_BASELINE_RECEIPT_MISSING
  [[ "$(< "$boot_file")" == "$current_boot" ]] || \
    die TIME_CALIBRATION MDU_BASELINE_BOOT_CHANGED
  [[ "$(< "$state_file")" == STOPPED ]] || \
    die TIME_CALIBRATION MDU_BASELINE_NOT_STOPPED

  time_calibration_restore_mdu
}

time_calibration_stop_mdu() {
  time_calibration_require_root "$@"
  local run_dir=/run/hope-time-calibration
  local active_file="$run_dir/mdu-active-services"
  local state_file="$run_dir/mdu-state"
  local boot_file="$run_dir/mdu-boot-id"
  local current_boot state=""
  current_boot="$(< /proc/sys/kernel/random/boot_id)"
  /usr/bin/install -d -o root -g root -m 0700 "$run_dir"
  exec 9>"$run_dir/mdu.lock"
  /usr/bin/flock -n 9 || die TIME_CALIBRATION ALREADY_RUNNING

  pgrep -f '[a]3_deploy_onnx_ref_pingpong' >/dev/null && \
    die TIME_CALIBRATION RUNNER_PRESENT
  has_unmanaged_hal && die TIME_CALIBRATION NON_VENDOR_HAL_PRESENT

  [[ -r "$state_file" ]] && state="$(< "$state_file")"
  if [[ "$state" != STOPPING && "$state" != STOPPED ]] ||
     [[ ! -r "$boot_file" || "$(< "$boot_file")" != "$current_boot" ]]; then
    : > "$active_file"
    local service
    for service in \
      agibot_roudi.service \
      agibot_top.service \
      agibot_ui.service \
      agibot_pm.service; do
      if /usr/bin/systemctl cat "$service" >/dev/null 2>&1 &&
         /usr/bin/systemctl is-active --quiet "$service"; then
        printf '%s\n' "$service" >> "$active_file"
      fi
    done
    printf '%s\n' "$current_boot" > "$boot_file"
  fi
  printf 'STOPPING\n' > "$state_file"

  local -a active_services=()
  mapfile -t active_services < "$active_file"
  if ((${#active_services[@]})); then
    # Stop dependants before RouDi. The vendor clock installer uses this
    # sequence; a single RouDi-first transaction can strand agibot_pm stop.
    local service
    for service in \
      agibot_pm.service \
      agibot_ui.service \
      agibot_top.service \
      agibot_roudi.service; do
      if printf '%s\n' "${active_services[@]}" | grep -Fxq -- "$service"; then
        /usr/bin/systemctl stop "$service" || \
          die TIME_CALIBRATION MDU_VENDOR_STOP_FAILED
      fi
    done
  fi
  /usr/bin/systemctl stop \
    agibot-mdu-phc2sys.service \
    agibot-mdu-ptp4l.service || die TIME_CALIBRATION MDU_PTP_STOP_FAILED

  ! pgrep -f '[a]3_deploy_onnx_ref_pingpong' >/dev/null || \
    die TIME_CALIBRATION RUNNER_REMAINS
  ! pgrep -f '[a]imrt_main_hal' >/dev/null || \
    die TIME_CALIBRATION HAL_REMAINS
  ! /usr/bin/systemctl is-active --quiet agibot-mdu-ptp4l.service || \
    die TIME_CALIBRATION MDU_PTP4L_REMAINS
  ! /usr/bin/systemctl is-active --quiet agibot-mdu-phc2sys.service || \
    die TIME_CALIBRATION MDU_PHC2SYS_REMAINS
  printf 'STOPPED\n' > "$state_file"
  emit TIME_CALIBRATION COMPLETE MDU_CLOCK_CONSUMERS_STOPPED
}

time_calibration_restore_mdu() {
  time_calibration_require_root "$@"
  local run_dir=/run/hope-time-calibration
  local active_file="$run_dir/mdu-active-services"
  local state_file="$run_dir/mdu-state"
  local boot_file="$run_dir/mdu-boot-id"
  local current_boot
  current_boot="$(< /proc/sys/kernel/random/boot_id)"
  [[ -d "$run_dir" ]] || die TIME_CALIBRATION MDU_RESTORE_RECEIPT_MISSING
  exec 9>"$run_dir/mdu.lock"
  /usr/bin/flock -n 9 || die TIME_CALIBRATION ALREADY_RUNNING
  [[ -r "$active_file" && -r "$state_file" && -r "$boot_file" ]] || \
    die TIME_CALIBRATION MDU_RESTORE_RECEIPT_MISSING
  [[ "$(< "$boot_file")" == "$current_boot" ]] || \
    die TIME_CALIBRATION MDU_RESTORE_BOOT_CHANGED
  [[ "$(< "$state_file")" == STOPPED ]] || \
    die TIME_CALIBRATION MDU_NOT_IN_STOPPED_STATE

  /usr/bin/systemctl start \
    agibot-mdu-ptp4l.service \
    agibot-mdu-phc2sys.service || die TIME_CALIBRATION MDU_PTP_RESTORE_FAILED
  /usr/bin/systemctl is-active --quiet agibot-mdu-ptp4l.service || \
    die TIME_CALIBRATION MDU_PTP4L_NOT_ACTIVE
  /usr/bin/systemctl is-active --quiet agibot-mdu-phc2sys.service || \
    die TIME_CALIBRATION MDU_PHC2SYS_NOT_ACTIVE
  sleep 5

  local service
  while IFS= read -r service; do
    [[ -n "$service" ]] || continue
    case "$service" in
      agibot_roudi.service|agibot_top.service|agibot_ui.service|agibot_pm.service) ;;
      *) die TIME_CALIBRATION INVALID_MDU_RESTORE_RECEIPT ;;
    esac
    /usr/bin/systemctl start "$service" || \
      die TIME_CALIBRATION MDU_VENDOR_RESTORE_FAILED
  done < "$active_file"
  while IFS= read -r service; do
    [[ -n "$service" ]] || continue
    /usr/bin/systemctl is-active --quiet "$service" || \
      die TIME_CALIBRATION MDU_VENDOR_NOT_ACTIVE
  done < "$active_file"
  printf 'RESTORED\n' > "$state_file"
  emit TIME_CALIBRATION COMPLETE MDU_PTP_AND_VENDOR_RESTORED
}

prepare_laptop() {
  local tracked_marker_frame world_transform=identity
  require_user "$LAPTOP_USER" SESSION
  case "$TABLE_SIDE" in
    P1) tracked_marker_frame=UCB_P1 ;;
    P2) tracked_marker_frame=UCB_P2 ;;
    *) die SESSION INVALID_TABLE_SIDE ;;
  esac
  cd "$HOPE_ROOT"
  mkdir -p "real_logs/$SESSION_ID/laptop"
  mkdir -p calibration
  [[ "$TABLE_SIDE" == P1 ]] || world_transform=rotate_z_pi_about_table_center
  printf '%s\n' "$SESSION_ID" > real_logs/.active_session_id
  {
    printf 'session_id=%s\n' "$SESSION_ID"
    printf 'table_side=%s\n' "$TABLE_SIDE"
    printf 'tracked_marker_frame=%s\n' "$tracked_marker_frame"
    printf 'world_transform=%s\n' "$world_transform"
  } > "real_logs/$SESSION_ID/laptop/runtime_frame_config.txt"
  {
    echo 'laptop UTC source for camera exposure and absolute strike deadline:'
    date -u --iso-8601=ns
    if command -v chronyc >/dev/null 2>&1; then
      test -s /etc/chrony/sources.d/hope-hdu.sources || true
      sha256sum /etc/chrony/sources.d/hope-hdu.sources 2>&1 || true
      chronyc sources -v 2>&1 || true
      chronyc tracking 2>&1 || true
    else
      timedatectl show -p NTPSynchronized -p TimeUSec 2>&1 || true
    fi
    echo 'hdu chrony + vendor PTP master:'
    ssh -T -o BatchMode=yes -o ConnectTimeout=3 "$ROBOT_USER@$HDU_WIFI_IP" \
      /bin/bash -s -- "$LAPTOP_WIFI_IP" 2>&1 <<'HDU_CLOCK' || true
laptop_ip="$1"
timedatectl show -p NTPSynchronized -p TimeUSec 2>&1 || true
systemctl is-enabled chrony.service 2>&1 || true
systemctl is-active chrony.service 2>&1 || true
systemctl is-enabled agibot-clock-bootstrap.service 2>&1 || true
chronyc tracking 2>&1 || true
chronyc -n sources -v 2>&1 || true
pgrep -a -f "[c]hronyd|[p]tp4l|[p]hc2sys|[n]tp2rtc" || true
sha256sum \
  /opt/agibot/entry/system/timesync.sh \
  /etc/chrony/chrony.conf \
  /etc/chrony/chrony-bootstrap.conf \
  /etc/systemd/system/agibot-clock-bootstrap.service \
  /etc/systemd/system/chrony.service.d/agibot-controls.conf \
  /etc/systemd/system/chrony.service.d/30-hope-laptop-server.conf \
  /etc/systemd/system/agibot_pm.service.d/20-clock-ordering.conf 2>&1 || true
sudo -n chronyc accheck "$laptop_ip" 2>&1 || true
sudo -n /opt/agibot/entry/system/timesync.sh --runtime-status 2>&1 || true
sudo -n /usr/sbin/pmc -u -b 0 "GET PORT_DATA_SET" 2>&1 || true
sudo -n /usr/sbin/pmc -u -b 0 "GET TIME_STATUS_NP" 2>&1 || true
HDU_CLOCK
    echo 'mdu systemd-supervised vendor-compatible PTP slave:'
    ssh -T -o BatchMode=yes -o ConnectTimeout=3 \
      -J "$ROBOT_USER@$HDU_WIFI_IP" "$ROBOT_USER@$MDU_INTERNAL_IP" \
      /bin/bash -s 2>&1 <<'MDU_CLOCK' || true
timedatectl show -p NTPSynchronized -p TimeUSec 2>&1 || true
systemctl is-enabled agibot-mdu-ptp4l.service agibot-mdu-phc2sys.service 2>&1 || true
systemctl is-active agibot-mdu-ptp4l.service agibot-mdu-phc2sys.service 2>&1 || true
systemctl show -p MainPID -p NRestarts -p ActiveState -p SubState \
  agibot-mdu-ptp4l.service agibot-mdu-phc2sys.service 2>&1 || true
pgrep -a -f "[p]tp4l|[p]hc2sys|[c]hronyd|[n]tp2rtc" || true
sha256sum \
  /opt/agibot/entry/system/timesync.sh \
  /etc/systemd/system/agibot-mdu-ptp4l.service \
  /etc/systemd/system/agibot-mdu-phc2sys.service \
  /etc/systemd/system/agibot_pm.service 2>&1 || true
sudo -n /usr/sbin/pmc -u -b 0 "GET TIME_STATUS_NP" 2>&1 || true
sudo -n /usr/sbin/pmc -u -b 0 "GET PORT_DATA_SET" 2>&1 || true
sudo -n journalctl -u agibot-mdu-ptp4l.service \
  -u agibot-mdu-phc2sys.service --since "-10 min" --no-pager 2>&1 || true
MDU_CLOCK
  } > "real_logs/$SESSION_ID/laptop/clock_snapshot.txt"
  emit SESSION COMPLETE LAPTOP_PREPARED
}

preflight_laptop() {
  require_user "$LAPTOP_USER" PREFLIGHT
  # Laptop remains the session/log collector, but its optional OptiTrack,
  # marker, calibration and packetizer stack is no longer a Runner startup
  # dependency.  Do not reject an absent overlay, Motive connection or an
  # independently managed mocap session here.
  [[ -d "$HOPE_ROOT" ]] || die PREFLIGHT LAPTOP_ROOT_MISSING
  command -v ssh >/dev/null || die PREFLIGHT SSH_MISSING
  command -v rsync >/dev/null || die PREFLIGHT RSYNC_MISSING
  emit PREFLIGHT COMPLETE LAPTOP_LOG_COLLECTOR_READY
}

prepare_hdu() {
  require_user "$ROBOT_USER" SESSION
  printf '%s\n' "$SESSION_ID" > /tmp/hope_model21800_session_id
  mkdir -p "/tmp/hope_real/$SESSION_ID/hdu"
  printf 'table_side=%s\n' "$TABLE_SIDE" > \
    "/tmp/hope_real/$SESSION_ID/hdu/runtime_frame_config.txt"
  emit SESSION COMPLETE HDU_PREPARED
}

preflight_hdu() {
  local planner_prefix messages_prefix static_peers
  require_user "$ROBOT_USER" PREFLIGHT
  tmux_exists "$HDU_BASE_SESSION" && die PREFLIGHT MANAGED_BASE_PRESENT
  tmux_exists "$HDU_PLANNER_SESSION" && die PREFLIGHT MANAGED_PLANNER_PRESENT
  tmux_exists "$HDU_RUNNER_TRANSPORT_SESSION" && \
    die PREFLIGHT MANAGED_RUNNER_TRANSPORT_PRESENT
  pgrep -u "$ROBOT_USER" -f '[h]ope_world.launch.py' >/dev/null && die PREFLIGHT UNMANAGED_BASE_PRESENT
  pgrep -u "$ROBOT_USER" -f '[h]ope-base-pose-transport-relay' >/dev/null && \
    die PREFLIGHT UNMANAGED_BASE_RELAY_PRESENT
  pgrep -u "$ROBOT_USER" -f '[h]ope-runner-transport-relay' >/dev/null && \
    die PREFLIGHT UNMANAGED_RUNNER_TRANSPORT_PRESENT
  pgrep -u "$ROBOT_USER" -f '(^|/)hope_planner_cpp_node([[:space:]]|$)' >/dev/null && \
    die PREFLIGHT UNMANAGED_PLANNER_PRESENT
  if [[ "$FIELD_MODE" == KERNEL ]]; then
    [[ -x /usr/local/libexec/hope-runner-transport-relay ]] || \
      die PREFLIGHT RUNNER_TRANSPORT_RELAY_MISSING
    [[ -r /opt/ros/jazzy/setup.bash ]] || die PREFLIGHT ROS_MISSING
    [[ -x "$HDU_WS/src/hope_bringup/scripts/with_fastdds_unicast.sh" ]] || \
      die PREFLIGHT DDS_WRAPPER_MISSING
    static_peers="$(network_static_peers)" || die PREFLIGHT HDU_DDS_PEERS_INVALID
    static_peer_list_contains "$static_peers" "$MDU_INTERNAL_IP" || \
      die PREFLIGHT HDU_DDS_MDU_PEER_MISSING
    command -v tmux >/dev/null || die PREFLIGHT TMUX_MISSING
    emit PREFLIGHT COMPLETE HDU_KERNEL_READY
    return
  fi
  [[ -r "$HDU_WS/install/local_setup.bash" ]] || \
    die PREFLIGHT HDU_BASE_OVERLAY_MISSING
