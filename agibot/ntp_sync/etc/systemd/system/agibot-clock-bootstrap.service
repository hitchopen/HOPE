[Unit]
Description=Qualify A3 system time before the distributed robot time domain
Wants=network-online.target
After=network-online.target
Before=chrony.service agibot_roudi.service agibot_pm.service
Before=agibot_top.service agibot_ui.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/agibot-clock-bootstrap
TimeoutStartSec=180s
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target

