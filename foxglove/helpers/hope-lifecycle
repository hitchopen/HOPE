  [[ -x "$MDU_DEPLOY/a3_deploy_onnx_ref_pingpong" ]] || \
    die PREFLIGHT RUNNER_EXECUTABLE_MISSING
  if [[ "$FIELD_MODE" == KERNEL ]]; then
    # Read-only capability checks reject mixed old/new deployments before HAL.
    grep -aFq -- '--kernel-mode' "$MDU_DEPLOY/a3_deploy_onnx_ref_pingpong" || \
      die PREFLIGHT KERNEL_RUNNER_UPDATE_REQUIRED
    grep -Fq -- '--kernel-mode' "$MDU_DEPLOY/run_a3_pingpong.sh" || \
      die PREFLIGHT KERNEL_WRAPPER_UPDATE_REQUIRED
  fi
  [[ -s "$MDU_DEPLOY/policy/exported/policy.onnx" ]] || \
    die PREFLIGHT POLICY_FILE_MISSING
  [[ -s "$MDU_DEPLOY/policy/params/deploy.yaml" ]] || \
    die PREFLIGHT POLICY_CONFIG_MISSING
  [[ -s "$MDU_DEPLOY/config/a3_runtime_config.pingpong.hitter_pingpong.yaml" ]] || \
    die PREFLIGHT RUNTIME_CONFIG_MISSING
  [[ -s "$MDU_DEPLOY/config/a3_aimrt_config.pingpong_iceoryx.yaml" ]] || \
    die PREFLIGHT AIMRT_CONFIG_MISSING
  [[ -s "$MDU_DEPLOY/motions/a3p_op3_serve025_new_build4_deep_1p07_compact50_lowdrop35_strikewindow180_full31_balanced_face20deg_forwardhit_v4.csv" ]] || \
    die PREFLIGHT SERVE025_TIMELINE_MISSING
  [[ -s "$MDU_DEPLOY/tools/a3p_gripper_bridge.py" ]] || \
    die PREFLIGHT GRIPPER_BRIDGE_MISSING
  command -v tmux >/dev/null || die PREFLIGHT TMUX_MISSING
  emit PREFLIGHT COMPLETE MDU_READY
}

