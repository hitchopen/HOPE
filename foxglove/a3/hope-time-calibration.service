[Unit]
Description=HOPE attended fixed HDU time-calibration coordinator
After=network-online.target hope-lifecycle-supervisor.service
Wants=network-online.target hope-lifecycle-supervisor.service

[Service]
Type=simple
User=root
Group=root
StateDirectory=hope-time-calibration
StateDirectoryMode=0700
Environment=ROS_DOMAIN_ID=232
Environment=ROS_LOCALHOST_ONLY=0
Environment=ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET
Environment=ROS_STATIC_PEERS=
EnvironmentFile=-/etc/hope-foxglove/network.env
Environment=RMW_IMPLEMENTATION=rmw_fastrtps_cpp
Environment=FASTRTPS_DEFAULT_PROFILES_FILE=/etc/hope-foxglove/fastdds_bridge_profile.xml
Environment=PYTHONPATH=/usr/local/lib/hope-foxglove
Environment=ROS_LOG_DIR=/var/lib/hope-time-calibration/ros-log
ExecStartPre=/usr/bin/install -d -m 0700 /var/lib/hope-time-calibration/ros-log
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && exec python3 /usr/local/bin/hope_time_calibration.py'
Restart=on-failure
RestartSec=2
TimeoutStopSec=5
NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/hope-time-calibration /var/lib/hope-lifecycle

[Install]
WantedBy=multi-user.target
