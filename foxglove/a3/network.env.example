# Copy to /etc/hope-foxglove/network.env on the HDU.
# Include both the Laptop Wi-Fi address and the MDU internal address reachable
# from the HDU. Multiple peers are separated with semicolons.
ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET
ROS_STATIC_PEERS=

# SSH accounts used by the fixed lifecycle supervisor. Agibot images normally
# use `agi`; set the Laptop account to the operator who installed the helper.
HOPE_LAPTOP_USER=operator
HOPE_ROBOT_USER=agi
