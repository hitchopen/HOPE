render_t3_elink_config() {
  python3 - "$MDU_ELINK_CONFIG" <<'PY_T3_HAL'
import copy
from pathlib import Path
import sys
import yaml

source = Path(sys.argv[1])
if not source.is_file() or source.is_symlink():
    raise SystemExit("T3 factory config must be a regular file")
raw = source.read_text()
base = yaml.safe_load(raw)
topic = "/body_drive/hand_joint_command"
subscribers = base["aimrt"]["channel"]["sub_topics_options"]
indices = [i for i, item in enumerate(subscribers) if item["topic_name"] == topic]
if len(indices) != 1:
    raise SystemExit("Expected exactly one T3 hand command subscriber")
index = indices[0]
if subscribers[index]["enable_backends"] not in (["iceoryx"], ["iceoryx", "ros2"]):
    raise SystemExit("Unexpected T3 hand command backend")
hand = base["ElinkModule"]["topic"]["upper"]["hand"]
if hand["command_topic"] != topic:
    raise SystemExit("ElinkModule hand command topic differs")
if type(hand.get("enable")) is not bool:
    raise SystemExit("Expected explicit boolean Elink topic.upper.hand.enable")
if base["ElinkModule"]["elink"]["upper"]["hand_enable"] is not True:
    raise SystemExit("Factory Elink hand transport is disabled")
workers = {item["name"] for item in base["aimrt"]["executor"]["executors"]}
if not {"hand_elink_server_worker", "hand_control_worker"} <= workers:
    raise SystemExit("Factory Elink hand executors are missing")
# Replace only the two YAML values; retain comments and formatting elsewhere.
tree = yaml.compose(raw)
def node_at(path):
    node = tree
    for key in path:
        if isinstance(key, int):
            node = node.value[key]
        else:
            matches = [value for name, value in node.value if name.value == key]
            if len(matches) != 1:
                raise SystemExit(f"Expected unique YAML key: {key}")
            node = matches[0]
    return node
replacements = []
for path, value in (
    (("aimrt", "channel", "sub_topics_options", index, "enable_backends"), "[iceoryx, ros2]"),
    (("ElinkModule", "topic", "upper", "hand", "enable"), "true"),
):
    node = node_at(path)
    end = node.end_mark.index
    if isinstance(node, yaml.SequenceNode) and not node.flow_style:
        end = node.value[-1].end_mark.index
        value = "  " + value
    replacements.append((node.start_mark.index, end, value))
rendered = raw
for start, end, value in sorted(replacements, reverse=True):
    rendered = rendered[:start] + value + rendered[end:]
expected = copy.deepcopy(base)
expected["aimrt"]["channel"]["sub_topics_options"][index]["enable_backends"] = ["iceoryx", "ros2"]
expected["ElinkModule"]["topic"]["upper"]["hand"]["enable"] = True
if yaml.safe_load(rendered) != expected:
    raise SystemExit("T3 Elink config differs beyond hand topic enable and command backend")
sys.stdout.write(rendered)
PY_T3_HAL
}

check_t3_hardware_config() {
  local step="$1"
  [[ -f "$MDU_ROBOT_MODEL_FILE" && ! -L "$MDU_ROBOT_MODEL_FILE" ]] || \
    die "$step" MDU_ROBOT_MODEL_MISSING
  [[ "$(<"$MDU_ROBOT_MODEL_FILE")" == "$MDU_SUPPORTED_ROBOT_MODEL" ]] || \
    die "$step" UNSUPPORTED_MDU_MODEL_FOR_GRIPPER
  [[ -f "$MDU_ELINK_CONFIG" && ! -L "$MDU_ELINK_CONFIG" ]] || \
    die "$step" ELINK_CONFIG_MISSING
  [[ -f "$MDU_HAL_GRIPPER_BASE_CONFIG" && ! -L "$MDU_HAL_GRIPPER_BASE_CONFIG" ]] || \
    die "$step" HAL_GRIPPER_CONFIG_MISSING
  render_t3_elink_config >/dev/null || die "$step" T3_ELINK_GRIPPER_CONFIG_INVALID
}

check_t3_elink_ready() {
  local step="$1" system_dir="/tmp/hope_real/$SESSION_ID/mdu/system"
  local elink_log="$system_dir/hal_elink.log"
  local elink_config="$system_dir/hal_elink_a3_gripper.yaml"
  grep -Fq -- "Enter ElinkKeepAliveLoop" "$elink_log" || die "$step" ELINK_NOT_READY
  grep -Fq -- "load config file: $elink_config" "$elink_log" || \
    die "$step" ELINK_CONFIG_NOT_LOADED
  grep -Fq -- "subscribe topic '/body_drive/hand_joint_command' success" "$elink_log" || \
    die "$step" ELINK_HAND_ROS2_SUBSCRIBER_NOT_REGISTERED
  grep -Eq -- '/body_drive/hand_joint_command[[:space:]]+\|[[:space:]]+pb:aimdk[.]protocol[.]HandCommandChannel[[:space:]]+\|[[:space:]]+ElinkModule[[:space:]]+\|[^|]*ros2' \
    "$elink_log" || die "$step" ELINK_HAND_TOPIC_BACKEND_NOT_REGISTERED
}

check_t3_hal_ready() {
  local step="$1" system_dir="/tmp/hope_real/$SESSION_ID/mdu/system"
  local hal_log="$system_dir/hal_ethercat.log"
  check_t3_elink_ready "$step"
  grep -Fq -- "load config file: $MDU_HAL_GRIPPER_BASE_CONFIG" "$hal_log" || \
    die "$step" HAL_GRIPPER_CONFIG_NOT_LOADED
  grep -Fq -- "ethercat controller start success." "$hal_log" || \
    die "$step" HAL_NOT_READY
}

preflight_mdu() {
