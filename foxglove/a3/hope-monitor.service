[Unit]
Description=HOPE A3 monitor node (NTP status, mocap RTT, joint aggregation)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agi
Environment=ROS_DOMAIN_ID=232
Environment=ROS_LOCALHOST_ONLY=0
Environment=RMW_IMPLEMENTATION=rmw_fastrtps_cpp
Environment=FASTRTPS_DEFAULT_PROFILES_FILE=/etc/hope-foxglove/fastdds_bridge_profile.xml
Environment=PYTHONPATH=/usr/local/lib/hope-foxglove
# Per-robot parameters: mocap host and, if this unit's TF tree differs from
# the fleet default, the pelvis/reference frame names.
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && \
  python3 /usr/local/bin/hope_monitor.py \
    --ros-args -p mocap_host:=REPLACE_WITH_MOCAP_HOST \
    -p pelvis_frame:=pelvis_link \
    -p reference_frame:=odom \
    -p ntp_max_offset_ms:=10.0 \
    -p ntp_max_skew_ppm:=5.0 \
    -p joint_publish_hz:=20.0 \
    -p joint_stale_after_s:=0.5'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
