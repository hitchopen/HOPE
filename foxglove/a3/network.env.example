# Copy to /etc/hope-foxglove/network.env on the HDU.
# Include both the Laptop Wi-Fi address and the MDU internal address reachable
# from the HDU. Multiple peers are separated with semicolons.
ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET
ROS_STATIC_PEERS=

# SSH accounts used by the fixed lifecycle supervisor. Agibot images normally
# use `agi`; set the Laptop account to the operator who installed the helper.
HOPE_LAPTOP_USER=operator
HOPE_ROBOT_USER=agi
# The Linux profile retains these existing defaults/overrides.
HOPE_LAPTOP_LIFECYCLE_HELPER=/usr/local/libexec/hope-lifecycle
# The Mac profile uses the container account and the stable reverse-SSH alias
# hope-mac-operator installed by scripts/macos/operator.py bind, independent of IP.
HOPE_MAC_USER=dongc1
HOPE_MAC_LIFECYCLE_HELPER=/home/dongc1/.local/libexec/hope-lifecycle
