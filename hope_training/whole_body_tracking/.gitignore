# Omniverse
**/*.dmp
**/.thumbs

# Python
.DS_Store
**/*.egg-info/
**/__pycache__/
**/.pytest_cache/
**/*.pyc
**/*.pb

# IDE
**/.idea/
**/.vscode/
# Don't ignore the top-level .vscode directory as it is
# used to configure VS Code settings
!.vscode

# Outputs
**/runs/*
**/logs/*
**/recordings/*
**/output/*
**/outputs/*
**/videos/*
**/wandb/*
**/.neptune/*
docker/artifacts/
*.tmp

# Isaac-Sim packman
_isaac_sim*
_repo
_build
.lastformat

*.csv
*.pkl
*.zarr
*.npz

# Ignore asset CONTENTS (meshes/urdf are huge) but keep the package marker files un-excluded —
# `whole_body_tracking.assets.__init__` defines ASSET_DIR and the tracking tasks fail to import
# without it (it silently vanished once as a gitignored file).
**/assets/
!source/whole_body_tracking/whole_body_tracking/assets/
source/whole_body_tracking/whole_body_tracking/assets/*
!source/whole_body_tracking/whole_body_tracking/assets/.gitignore
!source/whole_body_tracking/whole_body_tracking/assets/__init__.py

# V17 r12's physical tuple bank is a recipe input, not a generated run artifact.
# Keep the broad asset/NPZ ignores above, but allow only this SHA-pinned bank and
# its receipt so a checkout cannot silently lose 25% of the training question bank.
!assets/
assets/*
!assets/venue_tuple/
assets/venue_tuple/*
!assets/venue_tuple/v17_r12_physical_tuple_bank.npz
!assets/venue_tuple/v17_r12_physical_tuple_bank.receipt.json
artifacts/
