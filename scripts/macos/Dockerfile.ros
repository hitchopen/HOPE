FROM ros:jazzy-ros-base-noble@sha256:103b6c417973394659af6804d4917cd489b91e5ed22eb7bef263025a3bed2410

ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8 LC_ALL=C.UTF-8
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-jazzy-desktop ros-dev-tools ros-jazzy-foxglove-bridge \
    ros-jazzy-rosbag2-storage-mcap ros-jazzy-eigen3-cmake-module \
    ros-jazzy-ament-cmake-gtest ros-jazzy-ament-cmake-pytest \
    build-essential cmake ninja-build ccache coreutils git git-lfs patch \
    pkg-config procps tar util-linux wget curl rsync openssh-client \
    file binutils iproute2 iputils-ping netcat-openbsd \
    python3-catkin-pkg python3-colcon-common-extensions python3-empy \
    python3-lark python3-numpy python3-pip python3-protobuf python3-pytest \
    python3-rosdep python3-scipy python3-vcstool python3-venv python3-yaml \
    python3-matplotlib python3-pandas python3-evdev \
    cppzmq-dev libacl1-dev libboost-all-dev libeigen3-dev libfmt-dev libglm-dev \
    libgl1-mesa-dev libglfw3-dev libgtest-dev libssl-dev libmsgpack-cxx-dev \
    libx11-dev libxcursor-dev libxi-dev libxinerama-dev libpcl-dev \
    libprotobuf-dev protobuf-compiler libxrandr-dev libxxf86vm-dev \
    libyaml-cpp-dev libzmq3-dev rapidjson-dev x11-utils zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-jazzy-vrpn python3-onnx nlohmann-json3-dev xvfb xauth libgl1-mesa-dri \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work
CMD ["bash"]
