  printf 'HOPE_GRIPPER_CONFIG_T3_V2 transport=hand_command_topic_pb owner=hal_elink_t3d0 elink_factory_path=%s elink_factory_sha256=%s ethercat_path=%s ethercat_sha256=%s session_path=%s session_sha256=%s\n' \
    "$MDU_ELINK_CONFIG" "$(sha256sum "$MDU_ELINK_CONFIG" | cut -c1-64)" \
    "$MDU_HAL_GRIPPER_BASE_CONFIG" "$(sha256sum "$MDU_HAL_GRIPPER_BASE_CONFIG" | cut -c1-64)" \
    "$elink_config" "$(sha256sum "$elink_config" | cut -c1-64)" \
    > "$gripper_receipt"
  cat "$gripper_receipt"
  sudo -n systemctl stop agibot_pm.service || die HAL AGIBOT_PM_STOP_FAILED
  systemctl is-active --quiet agibot_pm.service && die HAL AGIBOT_PM_STOP_FAILED
  pgrep -f '[a]imrt_main_hal' >/dev/null && die HAL HAL_REMAINS_AFTER_AGIBOT_PM_STOP
  pgrep -f '[a]imrt_main .*hal_elink_a3(_ultra)?_(cfg|gripper)[.]yaml' >/dev/null && \
    die HAL ELINK_REMAINS_AFTER_AGIBOT_PM_STOP
  : > "$elink_log"
  : > "$hal_log"
  start_tmux "$MDU_ELINK_SESSION" "$SELF" _run-elink \
    "$SESSION_ID" "$LAPTOP_WIFI_IP" "$HDU_WIFI_IP" \
    "$MDU_INTERNAL_IP" "$MOTIVE_IP" "$TABLE_SIDE" "$FIELD_MODE" "$SERVE_CSV_SHA" || \
    die HAL ELINK_ALREADY_RUNNING
  wait_for_session_log "$MDU_ELINK_SESSION" "$elink_log" \
    "Enter ElinkKeepAliveLoop" 160 || die HAL ELINK_START_FAILED
  check_t3_elink_ready HAL
  emit HAL STARTING ELINK_READY_WITH_GRIPPER_TOPIC
  start_tmux "$MDU_HAL_SESSION" "$SELF" _run-hal \
    "$SESSION_ID" "$LAPTOP_WIFI_IP" "$HDU_WIFI_IP" \
    "$MDU_INTERNAL_IP" "$MOTIVE_IP" "$TABLE_SIDE" "$FIELD_MODE" "$SERVE_CSV_SHA" || die HAL ALREADY_RUNNING
  wait_for_session_log "$MDU_HAL_SESSION" "$hal_log" \
    "ethercat controller start success." 240 || die HAL SERVO_ENABLE_TIMEOUT
  check_t3_hal_ready HAL
  emit HAL COMPLETE HAL_RUNNING_WITH_GRIPPER_TOPIC
}

run_runner() {
  require_user "$ROBOT_USER" RUNNER
  set +u
  source /agibot/software/v0/entry/env/env.sh
  set -u
  cd "$MDU_DEPLOY"
  export A3_TRANSPORT=iceoryx
  export A3_SOURCE_ROBOT_ENV=0
  export A3_PINGPONG_RUNTIME_CFG="$PWD/config/a3_runtime_config.pingpong.hitter_pingpong.yaml"
  local real_root="/tmp/hope_real/$SESSION_ID/mdu/real"
  mkdir -p "$real_root"
  local attempt_number=1 attempt_id session_dir runner_rc
  while [[ -e "$real_root/$(printf 'attempt_%03d' "$attempt_number")" ]]; do
    attempt_number=$((attempt_number + 1))
  done
  attempt_id="$(printf 'attempt_%03d' "$attempt_number")"
  session_dir="$real_root/$attempt_id"
  mkdir -p "$session_dir"
  printf '%s\n' "$attempt_id" > "$real_root/current_attempt"
  date -u --iso-8601=seconds > "$session_dir/attempt_start_utc.txt"
  {
    date -u --iso-8601=seconds
    uname -a
    sha256sum a3_deploy_onnx_ref_pingpong run_a3_pingpong.sh \
      "$A3_PINGPONG_RUNTIME_CFG" policy/exported/policy.onnx \
      policy/params/deploy.yaml \
      /opt/agibot/entry/system/timesync.sh \
      /etc/systemd/system/agibot-mdu-ptp4l.service \
      /etc/systemd/system/agibot-mdu-phc2sys.service \
      /etc/systemd/system/agibot_pm.service
  } > "$session_dir/artifact_sha256.txt"
  local -a field_runner_args=(--planner)
  if [[ "$FIELD_MODE" == KERNEL ]]; then
    field_runner_args=(--kernel-mode)
    if [[ "$SERVE_CSV_SHA" != DEFAULT ]]; then
      local selected_csv="/agibot/hope-field-assets/$SERVE_CSV_SHA.csv"
      [[ -r "$selected_csv" ]] || die RUNNER SELECTED_CSV_MISSING
      [[ "$(sha256sum "$selected_csv" | cut -d ' ' -f 1)" == "$SERVE_CSV_SHA" ]] || \
        die RUNNER SELECTED_CSV_CHANGED
      field_runner_args+=(--serve-timeline "$selected_csv")
    fi
  fi
  if [[ -d "$PWD/teleop_humanlike" ]]; then
    local teleop_asset
    for teleop_asset in humanlike.yaml policy.onnx lin_vel_encoder.onnx; do
      [[ -r "$PWD/teleop_humanlike/$teleop_asset" ]] || die RUNNER TELEOP_ASSET_MISSING
      sha256sum "$PWD/teleop_humanlike/$teleop_asset" >> "$session_dir/artifact_sha256.txt"
    done
    field_runner_args+=(--teleop-policy-dir "$PWD/teleop_humanlike")
  fi
  printf 'mode=%s\ncsv_sha256=%s\n' "$FIELD_MODE" "$SERVE_CSV_SHA" > "$session_dir/field_selection.txt"
  set +e
  taskset -c 4-7 ./run_a3_pingpong.sh \
    --policy-dir "$PWD/policy" "${field_runner_args[@]}" --policy-native --serve \
    --no-fall-guard --no-data-csv \
    --start passive --official-stand \
    --session-id "$SESSION_ID" \
    > >(tee -a "$session_dir/runner.log") 2>&1
  runner_rc=$?
  set -e
  date -u --iso-8601=seconds > "$session_dir/attempt_end_utc.txt"
  printf '%s\n' "$runner_rc" > "$session_dir/runner_exit_code.txt"
  exit "$runner_rc"
}

runner_inputs_ready() {
  local runner_log="$1" input
  local -a required_inputs=(
    waist leg arm neck pelvis_imu torso_imu
  )
  # Runner's `ready=yes` is SubscriberBase::IsReady(): it can only become
  # true after a converted sample has reached that input's ring buffer.  Do
  # not require the separately streamed `samples=N` fragment on the same
  # physical line. AimRT writes to stderr concurrently and can split that
  # fragment with an initialization log, even though all six inputs are live.
  for input in "${required_inputs[@]}"; do
    grep -Eq "(^|[[:space:]])${input}[[:space:]]+ready=yes([^[:alpha:]_]|$)" \
      "$runner_log" || return 1
  done
  grep -Fq -- \
    "serve025 bridge ready; startup sent no gripper command" "$runner_log"
}

start_runner() {
  local system_dir="/tmp/hope_real/$SESSION_ID/mdu/system"
  local real_root="/tmp/hope_real/$SESSION_ID/mdu/real"
  local attempt attempt_id prior_attempt="" runner_log
  require_user "$ROBOT_USER" RUNNER
  tmux_exists "$MDU_ELINK_SESSION" || die RUNNER ELINK_NOT_RUNNING
  tmux_exists "$MDU_HAL_SESSION" || die RUNNER HAL_NOT_RUNNING
  check_t3_hal_ready RUNNER
  pgrep -u "$ROBOT_USER" -f '[a]3_deploy_onnx_ref_pingpong' >/dev/null && die RUNNER UNMANAGED_RUNNER_PRESENT
  if [[ -r "$real_root/current_attempt" ]]; then
    prior_attempt="$(<"$real_root/current_attempt")"
  fi
  start_tmux "$MDU_RUNNER_SESSION" "$SELF" _run-runner \
    "$SESSION_ID" "$LAPTOP_WIFI_IP" "$HDU_WIFI_IP" \
    "$MDU_INTERNAL_IP" "$MOTIVE_IP" "$TABLE_SIDE" "$FIELD_MODE" "$SERVE_CSV_SHA" || \
    die RUNNER ALREADY_RUNNING
  for ((attempt = 0; attempt < 72; attempt++)); do
    if [[ -r "$real_root/current_attempt" ]]; then
      attempt_id="$(<"$real_root/current_attempt")"
      if [[ "$attempt_id" =~ ^attempt_[0-9]{3}$ && \
            "$attempt_id" != "$prior_attempt" ]]; then
        runner_log="$real_root/$attempt_id/runner.log"
        if [[ -r "$runner_log" ]]; then
          grep -Fq -- "not all 6 topics ready within 5s" "$runner_log" && \
            die RUNNER HAL_INPUTS_NOT_READY
          grep -Fq -- "[a3p-gripper] ERROR:" "$runner_log" && \
            die RUNNER GRIPPER_BRIDGE_UNAVAILABLE
          grep -Fq -- "serve gripper bridge unavailable" "$runner_log" && \
            die RUNNER GRIPPER_BRIDGE_UNAVAILABLE
          if runner_inputs_ready "$runner_log"; then
            emit RUNNER COMPLETE RUNNER_PASSIVE
            return 0
          fi
        fi
      fi
    fi
    tmux_exists "$MDU_RUNNER_SESSION" || die RUNNER START_FAILED
    sleep 0.25
  done
  die RUNNER HAL_INPUTS_NOT_READY
}

stop_mdu() {
  require_user "$ROBOT_USER" RUNNER_HAL
  stop_tmux "$MDU_RUNNER_SESSION"
  emit RUNNER COMPLETE RUNNER_STOPPED
  stop_tmux "$MDU_HAL_SESSION"
  emit HAL COMPLETE HAL_STOPPED
  stop_tmux "$MDU_ELINK_SESSION"
  sudo -n systemctl start agibot_pm.service || die RUNNER_HAL AGIBOT_PM_RESTORE_FAILED
  systemctl is-active --quiet agibot_pm.service || die RUNNER_HAL AGIBOT_PM_NOT_ACTIVE
  emit RUNNER_HAL COMPLETE AGIBOT_PM_RESTORED
}

stop_hdu() {
  require_user "$ROBOT_USER" PLANNER_BASE
  stop_tmux "$HDU_RUNNER_TRANSPORT_SESSION"
  emit RUNNER_TRANSPORT COMPLETE RUNNER_TRANSPORT_STOPPED
  stop_tmux "$HDU_PLANNER_SESSION"
  emit PLANNER COMPLETE PLANNER_STOPPED
  stop_tmux "$HDU_BASE_SESSION"
  emit BASE_RELAY COMPLETE BASE_STOPPED
  emit PLANNER_BASE COMPLETE HDU_STOPPED
}

stop_laptop() {
  require_user "$LAPTOP_USER" OPTITRACK
  stop_tmux "$LAPTOP_SESSION"
  emit OPTITRACK COMPLETE BRIDGE_STOPPED
}

collect_logs() {
  require_user "$LAPTOP_USER" COLLECT
  cd "$HOPE_ROOT"
  local root="$HOPE_ROOT/real_logs/$SESSION_ID"
  local hdu_remote="/tmp/hope_real/$SESSION_ID/hdu"
  local mdu_remote="/tmp/hope_real/$SESSION_ID/mdu"
  local hdu_present=0 mdu_present=0 check_rc
  mkdir -p "$root/hdu" "$root/mdu"

  # A managed-stack preflight rejection can require STOP recovery before the
  # new session reaches prepare-{laptop,hdu,mdu}. In that case the remote log
  # directories legitimately do not exist. Distinguish that state from an SSH
  # failure so cleanup can finish and the supervisor can return to STOPPED.
  set +e
  ssh -T -o BatchMode=yes -o ConnectTimeout=3 \
    "$ROBOT_USER@$HDU_WIFI_IP" test -d "$hdu_remote"
  check_rc=$?
  set -e
  case "$check_rc" in
    0)
      hdu_present=1
      rsync -az "$ROBOT_USER@$HDU_WIFI_IP:$hdu_remote/" "$root/hdu/"
      ;;
    1) ;;
    255) die COLLECT HDU_UNREACHABLE ;;
    *) die COLLECT HDU_LOG_CHECK_FAILED ;;
  esac

  set +e
  ssh -T -o BatchMode=yes -o ConnectTimeout=3 \
    -J "$ROBOT_USER@$HDU_WIFI_IP" "$ROBOT_USER@$MDU_INTERNAL_IP" test -d "$mdu_remote"
  check_rc=$?
  set -e
  case "$check_rc" in
    0)
      mdu_present=1
      rsync -az -e "ssh -J $ROBOT_USER@$HDU_WIFI_IP" \
        "$ROBOT_USER@$MDU_INTERNAL_IP:$mdu_remote/" "$root/mdu/"
      ;;
    1) ;;
    255) die COLLECT MDU_UNREACHABLE ;;
    *) die COLLECT MDU_LOG_CHECK_FAILED ;;
  esac

  {
    printf 'session_id=%s\n' "$SESSION_ID"
    printf 'hdu_remote_logs=%s\n' "$hdu_present"
    printf 'mdu_remote_logs=%s\n' "$mdu_present"
  } > "$root/collection_status.txt"
  local status_path attempt_name
  for status_path in "$root"/hdu/x_hit_attempts/attempt_*.status; do
    [[ -e "$status_path" ]] || continue
    attempt_name="$(basename "$status_path" .status)"
    cp "$status_path" "$root/mdu/real/$attempt_name/x_hit.status" 2>/dev/null || true
  done
  case "$((hdu_present + mdu_present))" in
    0) emit COLLECT COMPLETE NO_REMOTE_SESSION_LOGS ;;
    1) emit COLLECT COMPLETE PARTIAL_LOGS_COLLECTED ;;
    2) emit COLLECT COMPLETE LOGS_COLLECTED ;;
  esac
}

main() {
  [[ "$#" -ge 1 ]] || exit 64
  local action="$1"
  shift
  case "$action" in
    field-assets-laptop)
      require_user "$LAPTOP_USER" FIELD_ASSETS
      export PYTHONPATH="$HOPE_ROOT/hope_ws/src/hope_bringup/scripts${PYTHONPATH:+:$PYTHONPATH}"
      exec python3 "$HOPE_ROOT/foxglove/a3/hope_field_assets.py" laptop --root "$HOPE_ROOT/calibration"
      ;;
    field-assets-mdu)
      require_user "$ROBOT_USER" FIELD_ASSETS
      # Match the packaged Runner's dynamic-library environment. Sourcing
      # these files starts no HAL, gripper or ROS node.
      set +u
      source /agibot/software/v0/entry/env/env.sh
      source /opt/ros/jazzy/setup.bash
      set -u
      export LD_LIBRARY_PATH="$MDU_DEPLOY:$MDU_DEPLOY/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
      exec python3 /usr/local/lib/hope-foxglove/hope_field_assets.py mdu \
        --root /agibot/hope-field-assets --validator "$MDU_DEPLOY/a3_deploy_onnx_ref_pingpong"
      ;;
    time-calibration-preflight-mdu)
      time_calibration_check_mdu "$@"
      return
      ;;
    time-calibration-recover-mdu)
      time_calibration_recover_mdu "$@"
      return
      ;;
    time-calibration-stop-mdu)
      time_calibration_stop_mdu "$@"
      return
      ;;
    time-calibration-restore-mdu)
      time_calibration_restore_mdu "$@"
      return
      ;;
  esac
  parse_common "$@" || {
    emit CONFIG FAILED INVALID_ARGUMENTS
    exit 64
  }
  case "$action" in
    preflight-laptop) preflight_laptop ;;
    preflight-hdu) preflight_hdu ;;
    preflight-mdu) preflight_mdu ;;
    prepare-laptop) prepare_laptop ;;
    prepare-hdu) prepare_hdu ;;
    prepare-mdu) prepare_mdu ;;
    start-laptop) start_laptop ;;
    start-base) start_base ;;
    start-runner-transport) start_runner_transport ;;
    start-planner) start_planner ;;
    start-hal) start_hal ;;
    start-runner) start_runner ;;
    stop-mdu) stop_mdu ;;
    stop-hdu) stop_hdu ;;
    stop-laptop) stop_laptop ;;
    collect) collect_logs ;;
    _run-laptop) run_laptop ;;
    _run-base) run_base ;;
    _run-runner-transport) run_runner_transport ;;
    _run-planner) run_planner ;;
    _run-elink) run_elink ;;
    _run-hal) run_hal ;;
    _run-runner) run_runner ;;
    *)
      emit CONFIG FAILED UNSUPPORTED_ACTION
      exit 64
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
