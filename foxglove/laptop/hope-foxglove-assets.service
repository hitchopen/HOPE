[Unit]
Description=HOPE Foxglove local table asset server
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/hope-foxglove
ExecStart=/usr/bin/python3 -m http.server 8000 --bind 127.0.0.1 --directory %h/.local/share/hope-foxglove
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
