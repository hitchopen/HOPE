#!/usr/bin/env bash
# Read-only visualization sidecar, independent of robot lifecycle/control.
set -eo pipefail
source "$HOME/.config/hope-foxglove/laptop-runtime.env"
source /opt/ros/jazzy/setup.bash
source "$HOPE_LIFECYCLE_ROOT/hope_ws/install/local_setup.bash"
set -u
# Keep DDS on the robot-route IPv4, including discovery of local publishers.
# A mixed loopback/NIC participant can hit Fast DDS partial-bind cleanup crashes.
# The WebSocket listener remains loopback-only in the Host bridge parameters.
display_peer="$(ip -o -4 route get "$HOPE_LIFECYCLE_HDU_IP" | awk '{for (i=1; i<=NF; ++i) if ($i == "src") {print $(i+1); exit}}')"
[[ -n "$display_peer" ]] || { echo '[display] no IPv4 source for robot route' >&2; exit 1; }
export OPENBLAS_NUM_THREADS=1
export OMP_NUM_THREADS=1
exec "$HOPE_LIFECYCLE_ROOT/hope_ws/install/hope_bringup/lib/hope_bringup/with_fastdds_unicast.sh" \
  --route-source-addresses --domain-id 232 --peer "$HOPE_LIFECYCLE_HDU_IP" --peer "$display_peer" -- \
  nice -n 10 python3 "$HOPE_LIFECYCLE_ROOT/foxglove/a3/hope_live_scene.py" \
  --root "$HOPE_LIFECYCLE_ROOT" \
  --scene-hz 20 --telemetry-hz 5 \
  --log-dir "$HOPE_LIFECYCLE_ROOT/real_logs/$HOPE_LIFECYCLE_SESSION_ID/laptop/live_scene"
