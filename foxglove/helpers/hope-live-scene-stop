#!/usr/bin/env python3
"""Stop only the laptop visualization process, including its SSH reader."""
import os
from pathlib import Path
import signal
import time

target = (Path(__file__).resolve().parents[1]/'a3/hope_live_scene.py').resolve()
found = []
for p in Path('/proc').iterdir():
    if not p.name.isdigit():
        continue
    try:
        args = (p/'cmdline').read_bytes().split(b'\0')
        if len(args)>1 and Path(args[1].decode()).resolve() == target:
            os.kill(int(p.name), signal.SIGINT)
            found.append(p)
    except (OSError, ValueError, UnicodeError):
        pass
for _ in range(50):
    if not any(p.exists() for p in found):
        break
    time.sleep(.1)
