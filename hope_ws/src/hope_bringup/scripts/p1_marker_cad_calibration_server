#!/usr/bin/env python3
"""Laptop-side service that refreshes the P1 calibration once per run."""

from __future__ import annotations

import os
from pathlib import Path
import subprocess

import rclpy
from rclpy.node import Node
from std_srvs.srv import Trigger

from p1_calibration import load_p1_calibration


class P1MarkerCadCalibrationServer(Node):
    def __init__(self) -> None:
        super().__init__("p1_marker_cad_calibration_server")
        self.declare_parameter(
            "calibrator_executable",
            str(Path(__file__).with_name("p1_marker_cad_calibrator")),
        )
        # Intentionally relative by default. Start the laptop bringup from the
        # HOPE repository root so the authoritative file remains in the repo's
        # calibration directory, independent of the robot filesystem.
        self.declare_parameter(
            "calibration_file", "calibration/p1_to_pelvis.json"
        )
        self.declare_parameter(
            "marker_topic", "/optitrack/rigid_body_markers"
        )
        self.declare_parameter("asset_name", "P1")
        self.declare_parameter(
            "marker_names", "f1,f2,f3,f4,f5,b1,b2,b3,b4,b5"
        )
        self.declare_parameter("mapping", "")
        self.declare_parameter("minimum_frames", 200)
        self.declare_parameter("capture_duration_s", 4.0)
        self.declare_parameter("capture_timeout_s", 15.0)
        self.declare_parameter("attest_installed_layout", True)
        self.declare_parameter("allow_nominal_markers", True)
        self.declare_parameter(
            "service_name", "/a3/calibration/recompute_p1"
        )

        self._service = self.create_service(
            Trigger,
            str(self.get_parameter("service_name").value),
            self._recompute,
        )
        self.get_logger().info(
            "laptop P1 calibration service ready; each request replaces the "
            "local JSON only after an approved fit"
        )

    def _output_path(self) -> Path:
        value = str(self.get_parameter("calibration_file").value).strip()
        if not value:
            raise ValueError("calibration_file is empty")
        return Path(value).expanduser().resolve()

    def _command(self, output_path: Path) -> list[str]:
        capture_timeout_s = float(
            self.get_parameter("capture_timeout_s").value
        )
        if capture_timeout_s <= 0.0:
            raise ValueError("capture_timeout_s must be positive")
        command = [
            str(self.get_parameter("calibrator_executable").value),
            "--topic",
            str(self.get_parameter("marker_topic").value),
            "--asset-name",
            str(self.get_parameter("asset_name").value),
            "--output",
            str(output_path),
            "--marker-names",
            str(self.get_parameter("marker_names").value),
            "--minimum-frames",
            str(int(self.get_parameter("minimum_frames").value)),
            "--capture-duration",
            str(float(self.get_parameter("capture_duration_s").value)),
            "--timeout",
            str(capture_timeout_s),
            "--stationary-prepare",
        ]
        mapping = str(self.get_parameter("mapping").value).strip()
        if mapping:
            command.extend(["--mapping", mapping])
        if bool(self.get_parameter("attest_installed_layout").value):
            command.append("--attest-installed-layout")
        if bool(self.get_parameter("allow_nominal_markers").value):
            command.append("--allow-nominal-only-markers")
        return command

    def _recompute(self, _request, response):
        try:
            output_path = self._output_path()
            output_path.parent.mkdir(parents=True, exist_ok=True)
            command = self._command(output_path)
            timeout_s = (
                float(self.get_parameter("capture_timeout_s").value) + 5.0
            )
            completed = subprocess.run(
                command,
                check=False,
                capture_output=True,
                text=True,
                timeout=timeout_s,
                env=os.environ.copy(),
            )
            if completed.returncode != 0:
                detail = (
                    completed.stderr
                    or completed.stdout
                    or f"calibrator exited {completed.returncode}"
                ).strip()
                raise RuntimeError(detail[-1200:])
            calibration = load_p1_calibration(output_path)
            if calibration.parent_frame != "P1":
                raise ValueError("calibration parent frame is not P1")
            if calibration.child_frame != "pelvis_link":
                raise ValueError("calibration child frame is not pelvis_link")
        except subprocess.TimeoutExpired:
            response.success = False
            response.message = "laptop P1 calibration timed out"
            self.get_logger().error(response.message)
            return response
        except (OSError, UnicodeError, TypeError, ValueError, RuntimeError) as exc:
            response.success = False
            response.message = str(exc)[-1200:]
            self.get_logger().error(f"laptop P1 calibration failed: {exc}")
            return response

        response.success = True
        response.message = calibration.receipt_sha256
        self.get_logger().info(
            f"replaced laptop P1 calibration {output_path} "
            f"sha={calibration.receipt_sha256}"
        )
        return response


def main() -> None:
    rclpy.init()
    node = P1MarkerCadCalibrationServer()
    try:
        rclpy.spin(node)
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == "__main__":
    main()
