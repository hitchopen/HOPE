<?xml version="1.0" encoding="UTF-8"?>
<!-- HDU FastDDS profile: UDPv4 on the internal MDU link and robot Wi-Fi.
     Shared memory remains disabled to avoid version mismatches with the
     vendor FastDDS build. The explicit laptop peer is supplied by systemd. -->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>bridge_udp</transport_id>
        <type>UDPv4</type>
        <maxInitialPeersRange>32</maxInitialPeersRange>
        <interfaceWhiteList>
          <address>10.42.10.10</address>
          <address>172.23.20.135</address>
        </interfaceWhiteList>
      </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="bridge_participant" is_default_profile="true">
      <rtps>
        <useBuiltinTransports>false</useBuiltinTransports>
        <userTransports>
          <transport_id>bridge_udp</transport_id>
        </userTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
