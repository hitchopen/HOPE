#!/usr/bin/env python3
"""Relay Avatar-Pro/CMAvatar VRPN topics into the HOPE ROS 2 mocap interface.

The relay supports two ways to track the ping-pong ball, chosen with the
``ball_tracking_mode`` parameter:

* ``rigid_body`` -- the ball is published as a named 6-DOF rigid body in
  CMTracker / MCServer. Set ``ball_object`` to that rigid-body name (e.g.
  ``Ball``); the relay subscribes to ``/vrpn_mocap/<ball_object>/pose`` and
  publishes its position straight to ``/ball/point``. Use this whenever a ball
  rigid body exists -- it is the most reliable method.

* ``auto`` (default, motion-based fallback) -- for setups where the ball cannot
  be made a rigid body and shows up only as an unnamed marker. The marker
  appears either as its own sender addressed by an opaque numeric id, or as one
  sensor channel of a sender; with ``multi_sensor:=true`` every sensor becomes
  ``/vrpn_mocap/<sender>/pose<sensor_index>`` (the index is a SUFFIX on
  ``pose`` -- e.g. ``/vrpn_mocap/MCAvatar/pose31664``). So we DISCOVER pose
  topics at runtime, match each on its VRPN *sender name* (the first path
  segment, making the trailing sensor-index harmless), and among the discovered
  topics that are not the named rigid bodies (PPT/UCB_P1/UCB_P2) pick the ball by
  MOTION: the one whose position actually moves.

Both modes share the same runtime topic discovery and ``/vrpn_mocap/<sender>/
pose`` sender-name matching; the only difference is whether the ball is pinned
to a known sender name (``rigid_body``) or selected by motion (``auto``).
"""

from __future__ import annotations

from dataclasses import dataclass

import rclpy
from geometry_msgs.msg import PointStamped, Pose, PoseArray, PoseStamped, TransformStamped
from rclpy.node import Node
from rclpy.qos import DurabilityPolicy, HistoryPolicy, QoSProfile, ReliabilityPolicy
from tf2_ros import TransformBroadcaster

_POSE_TYPE = "geometry_msgs/msg/PoseStamped"


@dataclass
class CandidateMotion:
    """Per-topic motion bookkeeping used to auto-detect the ball."""

    last_pos: tuple[float, float, float] | None = None
    last_rx: float = 0.0
    speed_ema: float = 0.0


class AvatarProVrpnRelay(Node):
    """Convert Avatar-Pro VRPN PoseStamped topics into HOPE-standard topics."""

    def __init__(self) -> None:
        super().__init__("avatar_pro_vrpn_relay")

        self.declare_parameter("vrpn_namespace", "/vrpn_mocap")
        self.declare_parameter("ppt_object", "PPT")
        self.declare_parameter("p1_object", "UCB_P1")
        self.declare_parameter("p2_object", "UCB_P2")
        # How to track the ball: "auto" = motion-based detection (fallback),
        # "rigid_body" = pin to the named rigid body in ball_object.
        self.declare_parameter("ball_tracking_mode", "auto")
        # In rigid_body mode: the ball rigid-body name in CMTracker (e.g. "Ball").
        # In auto mode: ignored (the ball is found by motion).
        self.declare_parameter("ball_object", "")
        self.declare_parameter("world_frame", "world")
        self.declare_parameter("table_pose_topic", "/table/pose")
        self.declare_parameter("p1_pose_topic", "/UCB_P1/pose")
        self.declare_parameter("p2_pose_topic", "/UCB_P2/pose")
        self.declare_parameter("ball_point_topic", "/ball/point")
        self.declare_parameter("poses_topic", "/poses")
        self.declare_parameter(
            "pose_array_order", ["ball", "PPT", "UCB_P1", "UCB_P2"]
        )
        self.declare_parameter("publish_tf", True)
        self.declare_parameter("publish_pose_array", True)
        # Runtime topic discovery + ball auto-detection tuning.
        self.declare_parameter("discovery_period_s", 0.5)
        self.declare_parameter("ball_motion_ema_alpha", 0.8)
        # Smoothed speed (m/s) above which a candidate is considered "moving".
        self.declare_parameter("ball_lock_speed_mps", 0.2)
        # A non-locked candidate must beat the locked one by this speed ratio
        # to steal the lock (hysteresis against flapping between markers).
        self.declare_parameter("ball_switch_ratio", 2.0)
        # Drop a candidate / release the lock after this long without messages.
        self.declare_parameter("ball_stale_s", 2.0)
        # Uniform scale applied to every relayed POSITION (poses, ball point, TF).
        # The chain works in METRES; some CMTracker/VRPN exports stream MILLIMETRES
        # (field 2026-07-07: /UCB_P1/pose read x=-315.9 -> mm) -> set
        # 0.001 there. Leave 1.0 when the mocap already streams metres.
        self.declare_parameter("position_scale", 1.0)

        self._vrpn_ns = str(self.get_parameter("vrpn_namespace").value).rstrip("/")
        self._ppt_object = str(self.get_parameter("ppt_object").value)
        self._p1_object = str(self.get_parameter("p1_object").value)
        self._p2_object = str(self.get_parameter("p2_object").value)
        self._position_scale = float(self.get_parameter("position_scale").value)
        if self._position_scale != 1.0:
            self.get_logger().info(
                f"position_scale={self._position_scale} (relayed positions are scaled; "
                "0.001 = mm->m for CMTracker feeds that stream millimetres)")
        # Resolve the ball tracking mode. `self._ball_name` non-empty => pin to
        # that VRPN sender (rigid_body); empty => motion-based auto-detect. The
        # rest of the relay keys off `self._ball_name`, so the mode only needs to
        # decide its value here.
        ball_object = str(self.get_parameter("ball_object").value).strip()
        mode = str(self.get_parameter("ball_tracking_mode").value).strip().lower()
        if mode not in ("auto", "rigid_body"):
            self.get_logger().error(
                f"unknown ball_tracking_mode '{mode}'; expected 'auto' or 'rigid_body'. "
                "Falling back to 'auto' (motion-based detection)."
            )
            mode = "auto"
        if mode == "rigid_body":
            if not ball_object or ball_object.lower() == "auto":
                self.get_logger().error(
                    "ball_tracking_mode='rigid_body' needs a ball_object rigid-body name "
                    "(e.g. ball_object:=Ball); none was given. Falling back to 'auto' detection."
                )
                mode = "auto"
                self._ball_name = ""
            else:
                self._ball_name = ball_object
        else:  # auto
            if ball_object and ball_object.lower() != "auto":
                self.get_logger().warn(
                    f"ball_tracking_mode='auto' ignores ball_object='{ball_object}'. "
                    "Use ball_tracking_mode:=rigid_body to track it as a named rigid body."
                )
            self._ball_name = ""
        self._mode = mode
        self._world_frame = str(self.get_parameter("world_frame").value)
        self._publish_tf = bool(self.get_parameter("publish_tf").value)
        self._publish_pose_array = bool(self.get_parameter("publish_pose_array").value)
        self._pose_array_order = [str(item) for item in self.get_parameter("pose_array_order").value]
        self._ema_alpha = float(self.get_parameter("ball_motion_ema_alpha").value)
        self._lock_speed = float(self.get_parameter("ball_lock_speed_mps").value)
        self._switch_ratio = float(self.get_parameter("ball_switch_ratio").value)
        self._stale_s = float(self.get_parameter("ball_stale_s").value)

        sensor_qos = QoSProfile(
            reliability=ReliabilityPolicy.BEST_EFFORT,
            durability=DurabilityPolicy.VOLATILE,
            history=HistoryPolicy.KEEP_LAST,
            depth=1,
        )
        self._sensor_qos = sensor_qos

        self._latest: dict[str, PoseStamped] = {}
        self._tf_broadcaster = TransformBroadcaster(self)
        self._pose_array_pub = self.create_publisher(
            PoseArray, str(self.get_parameter("poses_topic").value), sensor_qos
        )
        self._ball_pub = self.create_publisher(
            PointStamped, str(self.get_parameter("ball_point_topic").value), sensor_qos
        )
        self._pose_publishers = {
            "PPT": self.create_publisher(
                PoseStamped, str(self.get_parameter("table_pose_topic").value), sensor_qos
            ),
            "UCB_P1": self.create_publisher(
                PoseStamped, str(self.get_parameter("p1_pose_topic").value), sensor_qos
            ),
            "UCB_P2": self.create_publisher(
                PoseStamped, str(self.get_parameter("p2_pose_topic").value), sensor_qos
            ),
        }

        # topic -> ("PPT"|"UCB_P1"|"UCB_P2"|"ball"|"ball_candidate")
        self._subs: dict[str, object] = {}
        self._topic_key: dict[str, str] = {}
        self._motion: dict[str, CandidateMotion] = {}
        # The concrete topic currently treated as the ball (auto mode only).
        self._ball_topic: str | None = None

        self._discovery_timer = self.create_timer(
            float(self.get_parameter("discovery_period_s").value), self._discover_and_select
        )
        ball_point_topic = str(self.get_parameter("ball_point_topic").value)
        if self._ball_name:
            self.get_logger().info(
                f"ball_tracking_mode=rigid_body: tracking named rigid body "
                f"'{self._ball_name}' -> {ball_point_topic}"
            )
        else:
            self.get_logger().info(
                f"ball_tracking_mode=auto: locking onto the moving non-rigid marker "
                f"-> {ball_point_topic}"
            )

    # ---- discovery -------------------------------------------------------

    def _now(self) -> float:
        return self.get_clock().now().nanoseconds * 1e-9

    def _topic_to_sender(self, topic: str) -> str | None:
        """Return the VRPN sender name (first path segment) of a pose topic.

        vrpn_mocap names the pose topic differently depending on multi_sensor:
          * single sensor: ``/vrpn_mocap/PPT/pose``
          * multi_sensor:  ``/vrpn_mocap/PPT/pose_id_0`` (our vendored
            vrpn_mocap, tracker.hpp: channel + "_id_" + sensor_idx). Upstream
            builds have used a bare suffix instead (``pose0``, ``pose31664``).
        Some builds instead nest the index as its own segment
        (``/vrpn_mocap/PPT/0/pose``). All layouts -> sender ``PPT``. The type
        filter in _discover_and_select already drops the twist*/accel* topics,
        so here we only need to recognise a pose topic and read its sender.
        """
        prefix = self._vrpn_ns + "/"
        if not topic.startswith(prefix):
            return None
        segments = topic[len(prefix):].split("/")
        if len(segments) < 2:
            return None
        last = segments[-1]
        # "pose" (single/nested), "pose<idx>" (upstream multi_sensor) or
        # "pose_id_<idx>" (vendored multi_sensor).
        if last != "pose" \
                and not (last.startswith("pose") and last[4:].isdigit()) \
                and not (last.startswith("pose_id_") and last[8:].isdigit()):
            return None
        return segments[0]

    def _classify(self, sender: str) -> str | None:
        if sender == self._ppt_object:
            return "PPT"
        if sender == self._p1_object:
            return "UCB_P1"
        if sender == self._p2_object:
            return "UCB_P2"
        if self._ball_name:
            return "ball" if sender == self._ball_name else None
        return "ball_candidate"

    def _discover_and_select(self) -> None:
        for topic, types in self.get_topic_names_and_types():
            if topic in self._subs or _POSE_TYPE not in types:
                continue
            sender = self._topic_to_sender(topic)
            if sender is None:
                continue
            key = self._classify(sender)
            if key is None:
                continue
            self._subs[topic] = self.create_subscription(
                PoseStamped,
                topic,
                lambda msg, t=topic, k=key: self._on_pose(t, k, msg),
                self._sensor_qos,
            )
            self._topic_key[topic] = key
            if key == "ball_candidate":
                self._motion[topic] = CandidateMotion()
            self.get_logger().info(f"discovered {topic} -> {key}")

        if not self._ball_name:
            self._select_ball()

    def _select_ball(self) -> None:
        now = self._now()
        live = {
            t: m
            for t, m in self._motion.items()
            if m.last_pos is not None and (now - m.last_rx) <= self._stale_s
        }
        if not live:
            if self._ball_topic is not None:
                self.get_logger().warn("ball lost: no live marker candidates")
                self._ball_topic = None
            return

        if len(live) == 1:
            only = next(iter(live))
            self._set_ball_topic(only, reason="sole marker candidate")
            return

        ranked = sorted(live.items(), key=lambda kv: kv[1].speed_ema, reverse=True)
        best_topic, best = ranked[0]
        runner_speed = ranked[1][1].speed_ema if len(ranked) > 1 else 0.0

        # Hold the current lock if it is still live and not clearly beaten.
        if self._ball_topic in live:
            if best_topic == self._ball_topic:
                return
            if best.speed_ema < self._lock_speed:
                return
            if best.speed_ema < live[self._ball_topic].speed_ema * self._switch_ratio:
                return
            self._set_ball_topic(best_topic, reason=f"faster marker ({best.speed_ema:.2f} m/s)")
            return

        # No live lock: take the fastest mover above threshold; if nothing is
        # really moving yet, do not guess between several static markers.
        if best.speed_ema >= self._lock_speed and best.speed_ema >= runner_speed * self._switch_ratio:
            self._set_ball_topic(best_topic, reason=f"moving marker ({best.speed_ema:.2f} m/s)")

    def _set_ball_topic(self, topic: str, reason: str) -> None:
        if topic == self._ball_topic:
            return
        self._ball_topic = topic
        self.get_logger().info(f"ball -> {topic} ({reason})")

    # ---- message handling ------------------------------------------------

    def _on_pose(self, topic: str, key: str, msg: PoseStamped) -> None:
        if key in self._pose_publishers:  # PPT / UCB_P1 / UCB_P2
            normalized = self._normalize(msg)
            self._latest[key] = normalized
            self._pose_publishers[key].publish(normalized)
            if self._publish_tf:
                self._broadcast_tf(key, normalized)
            return

        if key == "ball_candidate":
            self._update_motion(topic, msg)
            if topic != self._ball_topic:
                return
        # key == "ball" (pinned) or this candidate is the selected ball.
        self._emit_ball(self._normalize(msg))

    def _update_motion(self, topic: str, msg: PoseStamped) -> None:
        m = self._motion.get(topic)
        if m is None:
            m = CandidateMotion()
            self._motion[topic] = m
        now = self._now()
        pos = (msg.pose.position.x, msg.pose.position.y, msg.pose.position.z)
        if m.last_pos is not None:
            dt = now - m.last_rx
            if dt > 1e-4:
                dist = (
                    (pos[0] - m.last_pos[0]) ** 2
                    + (pos[1] - m.last_pos[1]) ** 2
                    + (pos[2] - m.last_pos[2]) ** 2
                ) ** 0.5
                speed = dist / dt
                m.speed_ema = self._ema_alpha * m.speed_ema + (1.0 - self._ema_alpha) * speed
        m.last_pos = pos
        m.last_rx = now

    def _emit_ball(self, normalized: PoseStamped) -> None:
        self._latest["ball"] = normalized
        out = PointStamped()
        out.header = normalized.header
        out.point = normalized.pose.position
        self._ball_pub.publish(out)
        if self._publish_tf:
            self._broadcast_tf("ball", normalized)
        # Publish /poses synchronized to the BALL update only. The ball is the
        # planner's input; firing on every object would re-emit a stale ball
        # position at PPT/UCB_P1/UCB_P2 timestamps and corrupt the polyfit.
        if self._publish_pose_array:
            self._publish_poses(normalized.header.stamp)

    def _normalize(self, msg: PoseStamped) -> PoseStamped:
        normalized = PoseStamped()
        normalized.header = msg.header
        if not normalized.header.frame_id:
            normalized.header.frame_id = self._world_frame
        if self._position_scale == 1.0:
            normalized.pose = msg.pose
        else:  # unit conversion (e.g. mm->m); orientation is unit-free
            s = self._position_scale
            normalized.pose = Pose()
            normalized.pose.position.x = msg.pose.position.x * s
            normalized.pose.position.y = msg.pose.position.y * s
            normalized.pose.position.z = msg.pose.position.z * s
            normalized.pose.orientation = msg.pose.orientation
        return normalized

    def _broadcast_tf(self, object_key: str, msg: PoseStamped) -> None:
        tf_msg = TransformStamped()
        tf_msg.header = msg.header
        tf_msg.header.frame_id = msg.header.frame_id or self._world_frame
        tf_msg.child_frame_id = object_key
        tf_msg.transform.translation.x = msg.pose.position.x
        tf_msg.transform.translation.y = msg.pose.position.y
        tf_msg.transform.translation.z = msg.pose.position.z
        tf_msg.transform.rotation = msg.pose.orientation
        self._tf_broadcaster.sendTransform(tf_msg)

    def _publish_poses(self, stamp) -> None:
        if "ball" not in self._latest:
            return

        msg = PoseArray()
        msg.header.stamp = stamp
        msg.header.frame_id = self._world_frame
        msg.poses = [
            self._latest[key].pose
            for key in self._pose_array_order
            if key in self._latest and isinstance(self._latest[key].pose, Pose)
        ]
        self._pose_array_pub.publish(msg)


def main(args=None) -> None:
    rclpy.init(args=args)
    node = AvatarProVrpnRelay()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()
