<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hope_bringup</name>
  <version>0.0.0</version>
  <description>Bringup launch files and configuration for the HOPE ROS 2 stack.</description>
  <maintainer email="maintainer@example.com">HOPE Maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>hope_planner_cpp</exec_depend>
  <!-- VRPN2ROS2 is an independently built/launched workspace. The VRPN
       relay consumes only standard geometry_msgs/PoseStamped, so hope_ws has
       no build or runtime package dependency on vrpn_mocap. -->
  <!-- The OptiTrack backend (optitrack_mct_relay / optitrack_hope_bridge /
       fake_optitrack_publisher) additionally needs the independently built
       NatNet2ROS2 workspace's motion_capture_tracking_interfaces package at
       runtime. INTENTIONALLY not declared as a dependency: those scripts
       import the msg lazily and fail with an actionable error, so hope_ws
       remains independently buildable for VRPN-only deployments.
       soft-dep: motion_capture_tracking_interfaces (OptiTrack backend only) -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
