    "css-loader": "7.1.2",
    "create-foxglove-extension": "1.3.2",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "style-loader": "4.0.0",
    "ts-loader": "9.5.1",
