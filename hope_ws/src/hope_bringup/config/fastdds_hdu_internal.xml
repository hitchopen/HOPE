<?xml version="1.0" encoding="UTF-8" ?>
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>hdu_internal_udp</transport_id>
        <type>UDPv4</type>
        <!-- DDS is confined to the HDU-MDU Ethernet. VRPN remains direct TCP
             over the mocap LAN interface. -->
        <interfaceWhiteList>
          <address>10.42.10.10</address>
        </interfaceWhiteList>
      </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="hope_hdu_internal" is_default_profile="true">
      <rtps>
        <useBuiltinTransports>false</useBuiltinTransports>
        <userTransports>
          <transport_id>hdu_internal_udp</transport_id>
        </userTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
